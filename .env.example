# ==============================================================================
# AABAR Computer Vision Service - Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# Camera Configuration
AABAR_CAMERA_INDEX=0
AABAR_FRAME_WIDTH=1280
AABAR_FRAME_HEIGHT=720
AABAR_TARGET_FPS=30
AABAR_BUFFER_SIZE=1

# MediaPipe Face Landmarker Configuration
AABAR_MODEL_PATH=models/face_landmarker.task
AABAR_NUM_FACES=1
AABAR_MIN_FACE_DETECTION_CONFIDENCE=0.5
AABAR_MIN_FACE_PRESENCE_CONFIDENCE=0.5
AABAR_MIN_TRACKING_CONFIDENCE=0.5
AABAR_RUNNING_MODE=VIDEO

# Visualization Configuration
AABAR_VIZ_ENABLED=true
AABAR_VIZ_MIRROR_DISPLAY=true
AABAR_WINDOW_NAME=AABAR - CV Service | Face & Iris Tracking
AABAR_DRAW_FACE_MESH=false
AABAR_DRAW_EYE_CONTOURS=true
AABAR_DRAW_BOUNDING_BOXES=true
AABAR_DRAW_IRIS=true
AABAR_DRAW_IRIS_CENTER=true
AABAR_DRAW_RATIOS=true
AABAR_DRAW_FPS=true
AABAR_DRAW_GAZE_DIRECTION=true
AABAR_DRAW_GAZE_CROSSHAIR=true
AABAR_DRAW_HEAD_POSE=true
AABAR_DRAW_EYE_OPENNESS=true

# Relative Gaze Estimation & Smoothing Configuration
AABAR_GAZE_H_CENTER_MIN=0.42
AABAR_GAZE_H_CENTER_MAX=0.58
AABAR_GAZE_V_CENTER_MIN=0.38
AABAR_GAZE_V_CENTER_MAX=0.62
AABAR_EAR_MIN=0.16
AABAR_EAR_MAX=0.32
AABAR_BLINK_THRESHOLD=0.18
AABAR_SMOOTHING_ALPHA=0.25
AABAR_SACCADE_THRESHOLD=0.12
AABAR_SACCADE_ALPHA=0.85
AABAR_MAX_INVALID_FRAMES=5
AABAR_ENABLE_HEAD_POSE=true
AABAR_ENABLE_POSE_COMPENSATION=true
AABAR_POSE_COMPENSATION_FACTOR=0.0065
AABAR_PITCH_COMPENSATION_FACTOR=0.0020
AABAR_MAX_HEAD_YAW=25.0
AABAR_MAX_HEAD_PITCH=20.0
AABAR_AUTO_CALIBRATE=true
AABAR_CALIBRATION_DURATION=1.5
AABAR_GAZE_H_ACT_THRESH=0.06
AABAR_GAZE_H_DEACT_THRESH=0.035
AABAR_GAZE_V_ACT_THRESH=0.07
AABAR_GAZE_V_DEACT_THRESH=0.04
AABAR_GAZE_V_UP_ACT_THRESH=0.045
AABAR_GAZE_V_UP_DEACT_THRESH=0.025
AABAR_GAZE_V_DOWN_ACT_THRESH=0.060
AABAR_GAZE_V_DOWN_DEACT_THRESH=0.035
AABAR_SACCADE_THRESHOLD_Y=0.050
AABAR_DIRECTION_PERSISTENCE=3
AABAR_ALLOW_COMPOUND_DIRECTIONS=false

# Phase 3: Screen Gaze Calibration, Mapping & Evaluation
AABAR_SCREEN_WIDTH=1920
AABAR_SCREEN_HEIGHT=1080
AABAR_CALIB_SETTLE_DURATION=0.8
AABAR_CALIB_COLLECT_DURATION=1.2
AABAR_CALIB_MIN_SAMPLES=15
AABAR_MAPPER_MODEL_TYPE=auto
AABAR_MAPPER_RIDGE_ALPHA=0.01
AABAR_NORMALIZE_FEATURES=true
AABAR_PROFILES_DIR=data/calibration
AABAR_EXPERIMENTS_DIR=data/experiments
AABAR_EXPORT_EXCEL=true
AABAR_VAL_REPEATS=1
AABAR_VAL_RANDOMIZE=false
AABAR_VAL_THRESH_2PCT=0.02
AABAR_VAL_THRESH_5PCT=0.05
AABAR_VAL_THRESH_10PCT=0.10
# AABAR_ACTIVE_PROFILE_PATH=data/calibration/profile_user_default.json
